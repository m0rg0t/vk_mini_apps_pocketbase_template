{
  "name": "universal-mini-app-template-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend for Universal VK/Telegram Mini App Template",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tunnel": "vk-tunnel --http-protocol=http --host=127.0.0.1 --port=5173",
    "deploy": "vite build && vk-miniapps-deploy",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@twa-dev/sdk": "^8.0.2",
    "@vkontakte/icons": "^3.74.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "@vkontakte/vk-bridge-react": "^2.0.1",
    "@vkontakte/vk-mini-apps-router": "^1.8.6",
    "@vkontakte/vkui": "^8.4.1",
    "pocketbase": "^0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vk-helpers": "^1.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@vkontakte/vk-miniapps-deploy": "^1.0.3",
    "@vkontakte/vk-tunnel": "^0.2.10",
    "eruda": "^3.4.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "@eslint/js": "^10.0.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
