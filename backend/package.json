{
  "name": "universal-mini-app-template-backend",
  "version": "1.0.0",
  "description": "Backend API for Universal VK/Telegram Mini App Template",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "vk-helpers": "^1.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globals": {
      "__filename": true,
      "__dirname": true
    },
    "transform": {},
    "setupFilesAfterEnv": [
